# ==============================================================================
# Jarvis OS - Environment Configuration Example
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# Server Network Settings
JARVIS_HOST=127.0.0.1
JARVIS_PORT=7777

# Storage Paths (defaults to ./state and ./brains relative to workspace root)
# In Docker containers, these default to /data/state and /brains
# JARVIS_STATE_DIR=/data/state
# JARVIS_BRAINS_DIR=/brains

# Security & Authentication
# Force login even on localhost (1/0). Automatically 1 when bound to a public IP.
JARVIS_REQUIRE_LOGIN=0

# Allowed hostnames for Host Header / DNS-rebinding protection (comma-separated)
JARVIS_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional pre-seeded admin credentials for headless / Docker deployment
# JARVIS_ADMIN_USER=admin
# JARVIS_ADMIN_PASSWORD=change-me-at-least-8-chars

# ==============================================================================
# LLM Providers & API Keys
# ==============================================================================

# OpenRouter (Access to free and commercial models, Claude, DeepSeek, Llama, Qwen)
# OPENROUTER_API_KEY=sk-or-v1-...

# Google Gemini API
# GEMINI_API_KEY=AIzaSy...

# Perplexity API (Sonar Online Search models)
# PERPLEXITY_API_KEY=pplx-...

# Local Ollama Server (Runs offline local models)
OLLAMA_HOST=http://127.0.0.1:11434

# ==============================================================================
# Integrations & Social Channels
# ==============================================================================

# Composio API (Connects to 250+ tools: Twitter, LinkedIn, GitHub, Google Calendar)
# COMPOSIO_API_KEY=...

# Telegram Bot (Direct voice & text communication with Jarvis)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# TELEGRAM_OWNER_ID=123456789

# ==============================================================================
# Defaults & Preferences
# ==============================================================================
DEFAULT_BRAIN_NAME=Brain Default
PINNED_LANGUAGE=ru
